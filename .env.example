# Copy this file to `.env` (which is git-ignored) and fill in your key.
# Ask AI (Ctrl+Alt+Space) uses the Gemini API; the free tier is enough.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Or keep using OpenRouter (set its endpoint in config.toml, see the README):
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Voice dictation (Ctrl+Alt+D) uses Groq's Whisper API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
